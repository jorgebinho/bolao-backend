{
	"$schema": "https://www.schemastore.org/tsconfig",
	"compilerOptions": {
		"lib": [
			"es2024",
			"ESNext.Array",
			"ESNext.Collection",
			"ESNext.Error",
			"ESNext.Iterator",
			"ESNext.Promise"
		],
		"module": "nodenext",
		"target": "es2025",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "nodenext",
		"strict": true,
		"alwaysStrict": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": false,
		"strictBindCallApply": false,
		"noFallthroughCasesInSwitch": false,
		"types": [
			"node"
		],
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@Config/*": [
				"./src/config/*"
			],
			"@Lib/*": [
				"./src/lib/*"
			],
			"@Middlwares/*": [
				"./src/middleware/*"
			],
			"@Routes/*": [
				"./src/routes/*"
			],
			"@Services/*": [
				"./src/services/*"
			],
		}
	}
}