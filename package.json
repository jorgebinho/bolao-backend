{
	"name": "bolao-backend",
	"version": "1.0.0",
	"description": "API REST do Bolão Copa do Mundo",
	"main": "dist/server.mjs",
	"type": "module",
	"scripts": {
		"dev": "tsx watch ./src/server.ts",
		"build": "prisma generate && tsdown",
		"start:prod": "node dist/server.mjs",
		"check": "biome check --write",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"db:seed:matches": "tsx scripts/importWorldCupMatches.js",
		"recalculate-scores": "tsx scripts/recalculateScores.js",
		"reminders:send": "tsx scripts/sendMatchReminders.js"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^8.0.10",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.9.1",
		"@types/nodemailer": "^8.0.0",
		"prisma": "^7.8.0",
		"tsdown": "^0.22.1",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3"
	}
}
