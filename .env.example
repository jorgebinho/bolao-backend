# Copie este arquivo para .env e preencha os valores

# Supabase PostgreSQL - Pegue em: Project Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# PostgreSQL com Docker
DATABASE_URL="postgresql://docker:docker@localhost:5432/bolao?sslmode=disable&schema=public"
DIRECT_URL="postgresql://docker:docker@localhost:5432/bolao?sslmode=disable&schema=public"

# JWT Secret - Gere uma string aleatória longa e segura
JWT_SECRET="sua-chave-secreta-super-segura-aqui-mude-isso-em-producao"

# Expiração do token JWT (ex: 7d, 30d, 1h)
JWT_EXPIRES_IN="7d"

# URL do frontend (para o CORS)
FRONTEND_URL="http://localhost:5173"

# Porta do servidor (opcional, padrão 3333)
PORT=3333

# Lembretes de palpite por e-mail
MATCH_REMINDERS_ENABLED="true"
MATCH_REMINDER_INTERVAL_MINUTES=5

# SMTP usado para enviar e-mails de lembrete
SMTP_HOST="smtp.seu-provedor.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="usuario-smtp"
SMTP_PASS="senha-smtp"
SMTP_FROM="Bolão <no-reply@seudominio.com>"
