# Copie este arquivo para .env e preencha os valores

# Supabase PostgreSQL - Pegue em: Project Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct URL (para migrations do Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret - Gere uma string aleatória longa e segura
JWT_SECRET="sua-chave-secreta-super-segura-aqui-mude-isso-em-producao"

# Expiração do token JWT (ex: 7d, 30d, 1h)
JWT_EXPIRES_IN="7d"

# URL do frontend (para o CORS)
FRONTEND_URL="http://localhost:5173"

# Porta do servidor (opcional, padrão 3333)
PORT=3333
