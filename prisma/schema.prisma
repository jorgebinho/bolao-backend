datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  UPCOMING
  LOCKED
  FINISHED
}

enum GroupRole {
  OWNER
  MEMBER
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  googleId         String?        @unique
  role             Role           @default(USER)
  points           Int            @default(0)
  guesses          Guess[]
  matchReminders   MatchReminderEmail[]
  groupMemberships GroupMember[]
  ownedGroups      Group[]        @relation("GroupOwner")
  championGuess    ChampionGuess?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("users")
}

model Match {
  id            String      @id @default(cuid())
  homeTeam      String
  awayTeam      String
  homeFlag      String?
  awayFlag      String?
  matchDate     DateTime
  stage         String?
  status        MatchStatus @default(UPCOMING)
  homeScore     Int?
  awayScore     Int?
  advancingTeam String?
  guesses       Guess[]
  reminders     MatchReminderEmail[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([matchDate])
  @@map("matches")
}

model Guess {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  homeGuess     Int
  awayGuess     Int
  advancingTeam String?
  points        Int      @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, matchId])
  @@map("guesses")
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  code        String        @unique
  isGlobal    Boolean       @default(false)
  ownerId     String?
  owner       User?         @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members     GroupMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id        String    @id @default(cuid())
  userId    String
  groupId   String
  role      GroupRole @default(MEMBER)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, groupId])
  @@map("group_members")
}

model ChampionGuess {
  id        String   @id @default(cuid())
  userId    String   @unique
  team      String
  points    Int      @default(0)
  isCorrect Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("champion_guesses")
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

model MatchReminderEmail {
  id      String   @id @default(cuid())
  userId  String
  matchId String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sentAt  DateTime @default(now())

  @@unique([userId, matchId])
  @@index([matchId])
  @@map("match_reminder_emails")
}
